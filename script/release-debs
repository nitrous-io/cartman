#!/bin/bash 

BUCKET="apt.nitrous.io"
LOCALREPO="$HOME/$BUCKET"

DISTS="precise trusty"
N2O_PP=`cat ~/.gpg/nitrous.passphrase.gpg`
N2O_KG=`cat ~/.gpg/nitrous.keygrip.gpg`

GPGAGENT=/usr/bin/gpg-agent
GPGAGENTCOUNT=`ps lax | grep gpg-agent | grep -v grep | wc -l`
GPGSOCKLINK=$HOME/.gnupg/S.gpg-agent
export GPG_TTY=$(tty)

run_agent() {
  echo "Starting gpg-agent ..."
  killall gpg-agent
  eval $( gpg-agent --daemon --allow-preset-passphrase --write-env-file )
}

link_agent_info() {
  echo "Linking gpg-agent env ..."
  GPGTMPSOCKET=`echo $GPG_AGENT_INFO | awk -F: '{print $1}'`
  [[ -h $GPGSOCKLINK ]] && rm -f $GPGSOCKLINK
  ln -s $GPGTMPSOCKET $GPGSOCKLINK
}

if [[ $GPGAGENTCOUNT -eq 0 ]] && [[ -z $GPG_AGENT_INFO ]]; then
  run_agent
  link_agent_info
elif [[ $GPGAGENTCOUNT -eq 1 ]] && [[ -z $GPG_AGENT_INFO ]]; then
  run_agent
  link_agent_info
fi

/usr/lib/gnupg2/gpg-preset-passphrase -P $N2O_PP --preset $N2O_KG

for DIST in $DISTS; do
	for P in $(find ./build -name "${PKGNAME}*.deb"); do
		DEB=`echo $P | awk -F/ '{ print $NF }' | awk -F_ '{ print $1}'`
		reprepro -b $LOCALREPO remove $DIST $DEB
	done
done

for DIST in $DISTS; do
	for DEB in $(find ./build -name "${PKGNAME}*.deb"); do
		reprepro -b $LOCALREPO includedeb $DIST $DEB
	done
done
