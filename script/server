#!/bin/bash

[ -n "$DEBUG" ] && set -o xtrace
shopt -s nullglob

if [ -f logs/nginx.pid ]
  then
    sudo rm logs/error.log
    kill -s QUIT $(cat logs/nginx.pid)
fi

CONFIG="config/nginx.conf"

if [ "$1" != "stop" ]; then
  while getopts ":c:" option; do
    case "${option}" in
      c) CONFIG=${OPTARG};;
    esac
  done

  nx -p `pwd` -c $CONFIG
fi
